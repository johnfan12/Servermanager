# Simplified Servermanager node configuration.
# Copy this file to .env and change the secrets before deployment.

SIMPLE_SERVERMANAGER_PORT=18881
SIMPLE_PUBLIC_HOST=vps.example.com

SIMPLE_JWT_SECRET=replace-with-a-long-random-secret
SIMPLE_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token
SIMPLE_JWT_EXPIRE_HOURS=24

SIMPLE_FRP_ENABLED=true
SIMPLE_FRP_SERVER_ADDR=vps.example.com
SIMPLE_FRP_SERVER_PORT=7000
SIMPLE_FRP_TOKEN=replace-with-frp-token
SIMPLE_FRP_CLIENT_BIN=/usr/local/bin/frpc

# Expose this node API to the VPS. Clustermanager can then use
# http://127.0.0.1:SIMPLE_API_REMOTE_PORT as the node api address.
SIMPLE_API_FRP_ENABLED=true
SIMPLE_API_REMOTE_PORT=18881
SIMPLE_API_LOCAL_PORT=18881
SIMPLE_API_PROXY_NAME=simple-servermanager-api-node1

# Public ports allocated for user tunnels.
SIMPLE_TUNNEL_REMOTE_PORT_RANGE=30000-39999

# SSH exposure policy. The simplified platform exposes this node SSH port by default.
SIMPLE_SSH_LOCAL_HOST=127.0.0.1
SIMPLE_SSH_LOCAL_PORT=22
SIMPLE_ALLOW_CUSTOM_TUNNELS=false

# Local exposure policy.
SIMPLE_ALLOW_NON_LOOPBACK=false
SIMPLE_REQUIRE_LISTENING_LOCAL_PORT=false
SIMPLE_STOP_TUNNELS_ON_EXIT=true

# Local Linux account login policy.
SIMPLE_PAM_SERVICE=login
SIMPLE_ALLOWED_UID_MIN=1000
SIMPLE_ALLOW_SYSTEM_USERS=false
SIMPLE_ALLOWED_GROUPS=
SIMPLE_ADMIN_USERS=
SIMPLE_ADMIN_GROUPS=sudo,wheel

SIMPLE_CORS_ALLOW_ORIGINS=http://localhost:9999
